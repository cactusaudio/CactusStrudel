{
  "name": "CactusStrudel",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-or-later",
  "description": "Local Strudel producer workspace with durable revisions and an explicit Agent Brain.",
  "engines": {
    "node": ">=20.10.0",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "build": "pnpm -r build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "pnpm -r --if-present typecheck",
    "verify": "./scripts/verify-repo.sh",
    "docs:check": "python3 scripts/check_docs.py",
    "dev:renderer": "pnpm --filter @cactus/renderer-page dev",
    "dev:ui": "pnpm --filter @cactus/producer-ui dev"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "packageManager": "pnpm@11.0.9"
}
