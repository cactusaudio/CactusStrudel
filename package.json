{
  "name": "cactus-strudel",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-or-later",
  "description": "Autonomous Strudel-centered music producer.",
  "engines": {
    "node": ">=20.10.0",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "build": "pnpm -r --filter './packages/*' --filter './apps/*' build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "dev:renderer": "pnpm --filter @cactus/renderer-page dev",
    "cactus": "pnpm --filter @cactus/cli cactus"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "packageManager": "pnpm@11.0.9"
}
