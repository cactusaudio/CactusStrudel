#!/usr/bin/env bash
# CactusStrudel — universal installer for macOS.
# Double-click in Finder. Steps:
#   1. unpack cactus-strudel-bundle.tar.gz next to itself → ~/CactusStrudel
#   2. install Node + pnpm if missing (via brew)
#   3. pnpm install in main repo + refs/strudel-monorepo
#   4. install Playwright Chromium (~200MB)
#   5. drop a CactusStrudel launcher on the Desktop
#   6. start serve.py and open the workbench in the default browser
#
# All API keys / URLs / paths are configured by the user from the in-app
# Settings page after first launch. No per-host detection needed here.

set -e

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$HERE"

TARBALL="$HERE/cactus-strudel-bundle.tar.gz"
CHECKSUM_FILE="$TARBALL.sha256"
DEST="$HOME/CactusStrudel"
LAUNCHER="$HOME/Desktop/CactusStrudel.command"

say() { printf "\033[1;33m▶\033[0m %s\n" "$*"; }
err() { printf "\033[1;31m✗\033[0m %s\n" "$*" >&2; }
ok()  { printf "\033[1;32m✓\033[0m %s\n" "$*"; }
warn(){ printf "\033[1;33m!\033[0m %s\n" "$*"; }

stop_existing_server() {
  local existing
  existing=$(lsof -nP -iTCP:8765 -sTCP:LISTEN -t 2>/dev/null | head -1)
  if [ -z "$existing" ]; then return 0; fi
  say "stopping previous serve.py on 8765 (pid=$existing)"
  kill "$existing" 2>/dev/null || true
  for _ in 1 2 3 4 5; do
    sleep 0.4
    if ! kill -0 "$existing" 2>/dev/null; then return 0; fi
  done
  warn "previous process still alive; sending SIGKILL (pid=$existing)"
  kill -9 "$existing" 2>/dev/null || true
}

cleanup_on_error() {
  local code=$?
  if [ "$code" != 0 ]; then
    err "install failed (exit $code). Read the messages above. The window will stay open."
    echo
    printf "press return to close..."
    read -r
  fi
}
trap cleanup_on_error EXIT

say "CactusStrudel installer — $(hostname -s)"

# ── 1. sanity ─────────────────────────────────────────────────────────
if [ ! -f "$TARBALL" ]; then
  err "cactus-strudel-bundle.tar.gz not found next to this script."
  err "expected at: $TARBALL"
  exit 1
fi
ok "found bundle ($(du -h "$TARBALL" | awk '{print $1}'))"
if [ -f "$CHECKSUM_FILE" ]; then
  say "verifying bundle checksum"
  expected="$(awk '{print $1}' "$CHECKSUM_FILE" | head -1)"
  actual="$(shasum -a 256 "$TARBALL" | awk '{print $1}')"
  if [ "$expected" != "$actual" ]; then
    err "bundle checksum mismatch"
    err "expected: $expected"
    err "actual:   $actual"
    exit 1
  fi
  ok "bundle checksum verified"
else
  warn "no checksum file found at $CHECKSUM_FILE; continuing without integrity verification"
fi

# ── 2. unpack ─────────────────────────────────────────────────────────
if [ -d "$DEST" ]; then
  say "$DEST already exists — preserving producer-brain/ then re-extracting"
  if [ -d "$DEST/producer-brain" ]; then
    BACKUP_PB="$DEST/producer-brain.preserved-$(date +%Y%m%d-%H%M%S)"
    mv "$DEST/producer-brain" "$BACKUP_PB"
    ok "preserved existing producer-brain → $BACKUP_PB"
  fi
fi
say "unpacking bundle to $HOME/"
tar -xzf "$TARBALL" -C "$HOME/"
ok "unpacked"
if [ -n "${BACKUP_PB:-}" ] && [ -d "$BACKUP_PB" ]; then
  rm -rf "$DEST/producer-brain"
  mv "$BACKUP_PB" "$DEST/producer-brain"
  ok "restored preserved producer-brain"
fi

cd "$DEST"

# ── 3. node + pnpm + python3 ──────────────────────────────────────────
if ! command -v node >/dev/null 2>&1; then
  if command -v brew >/dev/null 2>&1; then
    say "installing Node via Homebrew…"
    brew install node || { err "brew install node failed"; exit 2; }
  else
    err "Node is not installed and Homebrew isn't either."
    err "Install Homebrew first: https://brew.sh — then re-run this installer."
    exit 2
  fi
fi
ok "node: $(node --version)"

if ! command -v pnpm >/dev/null 2>&1; then
  if command -v brew >/dev/null 2>&1; then
    brew install pnpm || { err "brew install pnpm failed"; exit 2; }
  else
    corepack enable && corepack prepare pnpm@latest --activate
  fi
fi
ok "pnpm: $(pnpm --version)"

if ! command -v python3 >/dev/null 2>&1; then
  err "python3 is required but not found."
  err "macOS usually ships python3 with Command Line Tools — run: xcode-select --install"
  exit 2
fi
ok "python3: $(python3 --version 2>&1)"

# ── 4. main repo install ──────────────────────────────────────────────
say "running pnpm install in main repo (≈ 1-2 min first time)…"
pnpm install --prefer-offline 2>&1 | tail -8 || { err "pnpm install failed"; exit 3; }
ok "main repo dependencies installed"

# ── 5. strudel-monorepo install ───────────────────────────────────────
if [ -d "$DEST/refs/strudel-monorepo" ]; then
  say "running pnpm install inside refs/strudel-monorepo (≈ 1-2 min)…"
  (cd "$DEST/refs/strudel-monorepo" && pnpm install --prefer-offline 2>&1 | tail -8) || {
    err "strudel-monorepo install failed — render will not work"; exit 3;
  }
  ok "strudel-monorepo dependencies installed"
fi

# ── 6. Playwright Chromium ────────────────────────────────────────────
say "installing Playwright Chromium (~200MB)…"
# Playwright lives in a workspace package; install from the correct dir
PW_DIR=""
if [ -d "$DEST/apps/renderer-page" ] && [ -f "$DEST/apps/renderer-page/package.json" ] && grep -q "playwright" "$DEST/apps/renderer-page/package.json" 2>/dev/null; then
  PW_DIR="$DEST/apps/renderer-page"
elif [ -d "$DEST/apps/cli" ] && [ -f "$DEST/apps/cli/package.json" ] && grep -q "playwright" "$DEST/apps/cli/package.json" 2>/dev/null; then
  PW_DIR="$DEST/apps/cli"
elif [ -d "$DEST/packages/renderer" ] && [ -f "$DEST/packages/renderer/package.json" ] && grep -q "playwright" "$DEST/packages/renderer/package.json" 2>/dev/null; then
  PW_DIR="$DEST/packages/renderer"
fi
if [ -n "$PW_DIR" ]; then
  (cd "$PW_DIR" && pnpm exec playwright install chromium 2>&1 | tail -5) || warn "playwright install failed in $PW_DIR — run manually later"
  ok "Playwright Chromium ready"
else
  warn "couldn't locate workspace that owns playwright — run: cd <pkg_with_playwright> && pnpm exec playwright install chromium"
fi

# ── 7. Desktop launcher (no env baked in — config comes from Settings UI) ──
say "creating Desktop launcher at $LAUNCHER"
{
  echo '#!/usr/bin/env bash'
  echo '# CactusStrudel launcher — double-click to start the server and open the workbench.'
  echo '# All API keys / URLs / paths are configured in the in-app Settings page.'
  echo ''
  echo 'set -e'
  echo "cd \"$DEST\""
  echo ''
  echo 'existing=$(lsof -nP -iTCP:8765 -sTCP:LISTEN -t 2>/dev/null | head -1)'
  echo 'if [ -n "$existing" ]; then'
  echo '  echo "stopping previous serve.py (pid=$existing)"'
  echo '  kill "$existing" 2>/dev/null || true'
  echo '  for _ in 1 2 3 4 5; do sleep 0.4; kill -0 "$existing" 2>/dev/null || break; done'
  echo '  kill -0 "$existing" 2>/dev/null && kill -9 "$existing" 2>/dev/null || true'
  echo 'fi'
  echo ''
  echo 'nohup python3 runtime/serve.py >/tmp/cactus-serve.log 2>&1 &'
  echo 'echo "CactusStrudel started (pid=$!). log: /tmp/cactus-serve.log"'
  echo 'sleep 2'
  echo 'open "http://localhost:8765/runtime/main.html"'
} > "$LAUNCHER"
chmod +x "$LAUNCHER"
ok "Desktop launcher ready"

# ── 8. fire it up ────────────────────────────────────────────────────
say "starting serve.py and opening browser…"
stop_existing_server
nohup python3 runtime/serve.py >/tmp/cactus-serve.log 2>&1 &
sleep 2
open "http://localhost:8765/runtime/main.html"

echo
ok "install complete."
echo "  • workbench:  http://localhost:8765/runtime/main.html"
echo "  • data page:  http://localhost:8765/runtime/data.html"
echo "  • settings:   http://localhost:8765/runtime/settings.html  ← configure backends here"
echo "  • launcher:   $LAUNCHER  (double-click any time to relaunch)"
echo "  • log:        tail -f /tmp/cactus-serve.log"
echo
echo "  First-time setup: open the Settings page and add at least one of:"
echo "    • CLIProxy URL + key (if you run a local gateway)"
echo "    • OpenAI / Anthropic / Google / xAI API key (for direct vendor access)"
echo "    • AGY CLI binary path (if installed, otherwise skip)"
echo
printf "press return to close this window..."
read -r
