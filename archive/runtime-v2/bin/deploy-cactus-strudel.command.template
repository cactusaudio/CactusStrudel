#!/usr/bin/env bash
# CactusStrudel — one-shot deployer for macOS (v2).
# Double-click this file in Finder. It will:
#   1. unpack cactus-strudel-bundle.tar.gz next to itself → ~/CactusStrudel
#   2. install Node + pnpm if missing (via brew)
#   3. run pnpm install (main repo + refs/strudel-monorepo)
#   4. install Playwright Chromium (needed for headless Strudel render)
#   5. detect a running CLIProxy gateway (port 8317 or 8318)
#   6. pick the API-key doc whose content matches the detected port
#   7. drop a CactusStrudel launcher on the Desktop (one-click open)
#   8. start serve.py and open the workbench in the default browser
# Re-runnable; safe if already installed (won't clobber producer-brain/).

set -e

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$HERE"

TARBALL="$HERE/cactus-strudel-bundle.tar.gz"
DEST="$HOME/CactusStrudel"
LAUNCHER="$HOME/Desktop/CactusStrudel.command"

say() { printf "\033[1;33m▶\033[0m %s\n" "$*"; }
err() { printf "\033[1;31m✗\033[0m %s\n" "$*" >&2; }
ok()  { printf "\033[1;32m✓\033[0m %s\n" "$*"; }
warn(){ printf "\033[1;33m!\033[0m %s\n" "$*"; }

cleanup_on_error() {
  local code=$?
  if [ "$code" != 0 ]; then
    err "deploy failed (exit $code). Read the messages above. The window will stay open."
    echo
    printf "press return to close..."
    read -r
  fi
}
trap cleanup_on_error EXIT

# ── 1. sanity checks ────────────────────────────────────────────────────
say "CactusStrudel deployer v2 — bowei@$(hostname -s)"

if [ ! -f "$TARBALL" ]; then
  err "cactus-strudel-bundle.tar.gz not found next to this script."
  err "expected at: $TARBALL"
  exit 1
fi
ok "found bundle ($(du -h "$TARBALL" | awk '{print $1}'))"

# ── 2. unpack ───────────────────────────────────────────────────────────
if [ -d "$DEST" ]; then
  say "$DEST already exists — preserving producer-brain/ and re-extracting source"
  if [ -d "$DEST/producer-brain" ]; then
    BACKUP_PB="$DEST/producer-brain.preserved-$(date +%Y%m%d-%H%M%S)"
    mv "$DEST/producer-brain" "$BACKUP_PB"
    ok "preserved existing producer-brain → $BACKUP_PB"
  fi
fi
say "unpacking bundle to $HOME/"
tar -xzf "$TARBALL" -C "$HOME/"
ok "unpacked"
if [ -n "${BACKUP_PB:-}" ] && [ -d "$BACKUP_PB" ]; then
  rm -rf "$DEST/producer-brain"
  mv "$BACKUP_PB" "$DEST/producer-brain"
  ok "restored preserved producer-brain"
fi

cd "$DEST"

# ── 3. dependencies (node + pnpm + python3) ─────────────────────────────
if ! command -v node >/dev/null 2>&1; then
  if command -v brew >/dev/null 2>&1; then
    say "installing Node via Homebrew (may take a minute)…"
    brew install node || { err "brew install node failed"; exit 2; }
  else
    err "Node is not installed and Homebrew isn't either."
    err "Install Homebrew first: https://brew.sh — then re-run this deployer."
    exit 2
  fi
fi
ok "node: $(node --version)"

if ! command -v pnpm >/dev/null 2>&1; then
  if command -v brew >/dev/null 2>&1; then
    say "installing pnpm via Homebrew…"
    brew install pnpm || { err "brew install pnpm failed"; exit 2; }
  else
    say "installing pnpm via corepack…"
    corepack enable && corepack prepare pnpm@latest --activate
  fi
fi
ok "pnpm: $(pnpm --version)"

if ! command -v python3 >/dev/null 2>&1; then
  err "python3 is required but not found."
  err "macOS usually ships python3 with Command Line Tools — run: xcode-select --install"
  exit 2
fi
ok "python3: $(python3 --version 2>&1)"

# ── 4. pnpm install (main repo) ─────────────────────────────────────────
say "running pnpm install in main repo (≈ 1-2 minutes first time)…"
pnpm install --prefer-offline 2>&1 | tail -8 || {
  err "pnpm install failed — see output above"
  exit 3
}
ok "main repo dependencies installed"

# ── 5. pnpm install inside refs/strudel-monorepo ────────────────────────
# The renderer-page vite config aliases @strudel/* to refs/strudel-monorepo
# /packages/*. Those packages have internal symlinks into the monorepo's
# OWN node_modules. We ship the source but not those node_modules → must
# install them on the target.
if [ -d "$DEST/refs/strudel-monorepo" ]; then
  say "running pnpm install inside refs/strudel-monorepo (≈ 1-2 minutes)…"
  (cd "$DEST/refs/strudel-monorepo" && pnpm install --prefer-offline 2>&1 | tail -8) || {
    err "strudel-monorepo install failed — render will not work"
    exit 3
  }
  ok "strudel-monorepo dependencies installed"
fi

# ── 6. Playwright Chromium ──────────────────────────────────────────────
say "installing Playwright Chromium for headless Strudel render (~200MB)…"
pnpm exec playwright install chromium 2>&1 | tail -5 || {
  warn "playwright install failed — generate will fail until you run: cd $DEST && pnpm exec playwright install chromium"
}
ok "Playwright Chromium ready"

# ── 7. detect CLIProxy gateway ──────────────────────────────────────────
CLIPROXY_PORT=""
for port in 8317 8318; do
  if curl -s --max-time 2 "http://127.0.0.1:${port}/healthz" >/dev/null 2>&1; then
    CLIPROXY_PORT=$port
    break
  fi
done
if [ -n "$CLIPROXY_PORT" ]; then
  ok "CLIProxy gateway running on port $CLIPROXY_PORT"
  CLIPROXY_BASE_URL="http://127.0.0.1:${CLIPROXY_PORT}/v1"
else
  warn "no local CLIProxy gateway detected (tried 8317 + 8318)."
  warn "CLIProxy slots (6 of 7 model backends) will fail until you start one."
  warn "AGY CLI slot still works if ~/.local/bin/agy is installed."
  CLIPROXY_PORT="8317"
  CLIPROXY_BASE_URL="http://127.0.0.1:8317/v1"
fi

# ── 8. pick the right CLIProxy key doc (match by port content) ──────────
# Each macOS host may have multiple CLIProxyAPI-*.md docs from different
# CLIProxy installations. The key inside is per-host. To pick the right one,
# we look for a doc whose body mentions the detected port.
KEY_DOC=""
shopt -s nullglob
for candidate in "$HOME/Downloads"/CLIProxyAPI*-LAN-API-Key-Usage.md "$HOME/Downloads"/CLIProxyAPI*Usage.md; do
  [ -f "$candidate" ] || continue
  # Look for the detected port in the doc body
  if grep -q "127\.0\.0\.1:${CLIPROXY_PORT}\|:${CLIPROXY_PORT}/v1\|port ${CLIPROXY_PORT}" "$candidate" 2>/dev/null; then
    KEY_DOC="$candidate"
    break
  fi
done
shopt -u nullglob
# Fallback: any first matching doc (legacy behavior)
if [ -z "$KEY_DOC" ]; then
  for candidate in \
      "$HOME/Downloads/CLIProxyAPI-LAN-API-Key-Usage.md" \
      "$HOME/Downloads/CLIProxyAPI-MacBook-Pro-LAN-API-Key-Usage.md" \
      "$HOME/Downloads/CLIProxyAPI-MacBook-Air-LAN-API-Key-Usage.md"; do
    if [ -f "$candidate" ]; then
      KEY_DOC="$candidate"
      warn "fallback key doc (no port match): $(basename "$candidate")"
      break
    fi
  done
fi
if [ -n "$KEY_DOC" ]; then
  ok "CLIProxy key doc: $KEY_DOC"
else
  warn "no CLIProxy key doc found in ~/Downloads/ — chat / CLIProxy slots will need the key configured later."
fi

# ── 9. AGY CLI optional check ──────────────────────────────────────────
if [ -x "$HOME/.local/bin/agy" ]; then
  ok "AGY CLI binary present"
else
  warn "AGY CLI binary not at ~/.local/bin/agy. AGY slot will be unavailable until installed."
fi

# ── 10. write Desktop launcher ─────────────────────────────────────────
say "creating Desktop launcher at $LAUNCHER"
# Use a quoted heredoc so $vars don't expand; we splice in the resolved
# values via concatenation. Simpler than escaping inside an unquoted heredoc.
{
  echo '#!/usr/bin/env bash'
  echo '# CactusStrudel launcher — double-click to start the server and open the workbench.'
  echo ''
  echo 'set -e'
  echo "cd \"$DEST\""
  echo ''
  echo "export CLIPROXY_BASE_URL=\"$CLIPROXY_BASE_URL\""
  if [ -n "$KEY_DOC" ]; then
    echo "export CLIPROXY_KEY_DOC=\"$KEY_DOC\""
  fi
  echo ''
  echo '# Kill any existing serve.py on port 8765 (clean restart)'
  echo 'existing=$(lsof -nP -iTCP:8765 -sTCP:LISTEN -t 2>/dev/null | head -1)'
  echo 'if [ -n "$existing" ]; then'
  echo '  echo "stopping previous serve.py (pid=$existing)"'
  echo '  kill "$existing" 2>/dev/null || true'
  echo '  sleep 1'
  echo 'fi'
  echo ''
  echo 'nohup python3 runtime/serve.py >/tmp/cactus-serve.log 2>&1 &'
  echo 'echo "CactusStrudel serve.py started (pid=$!). log: /tmp/cactus-serve.log"'
  echo 'sleep 2'
  echo 'open "http://localhost:8765/runtime/main.html"'
} > "$LAUNCHER"
chmod +x "$LAUNCHER"
ok "Desktop launcher ready"

# ── 11. fire it up ─────────────────────────────────────────────────────
say "starting serve.py and opening browser…"
export CLIPROXY_BASE_URL
[ -n "$KEY_DOC" ] && export CLIPROXY_KEY_DOC="$KEY_DOC"
existing=$(lsof -nP -iTCP:8765 -sTCP:LISTEN -t 2>/dev/null | head -1)
if [ -n "$existing" ]; then
  kill "$existing" 2>/dev/null || true
  sleep 1
fi
nohup python3 runtime/serve.py >/tmp/cactus-serve.log 2>&1 &
sleep 2
open "http://localhost:8765/runtime/main.html"

echo
ok "deploy complete."
echo "  • workbench:  http://localhost:8765/runtime/main.html"
echo "  • data page:  http://localhost:8765/runtime/data.html"
echo "  • launcher:   $LAUNCHER  (double-click any time to relaunch)"
echo "  • log:        tail -f /tmp/cactus-serve.log"
echo
printf "press return to close this window..."
read -r
