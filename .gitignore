# Local-only archives. Tracked historical source belongs under
# archive/research-v1; bulky generated evidence and reference corpora do not.
archive/local/*
!archive/local/README.md

# Ephemeral handoff snapshots. The generator and format contract are tracked;
# the latest machine/session snapshot is not.
handoffs/*.md
!handoffs/README.md

# Editor
.vscode/
.idea/
*.swp

# Renders (huge, regenerable)
*.wav
*.mp3
*.flac
*.opus
!tests/fixtures/audio/*.wav

# Logs
*.log
*.bak.*
*.bak-*
*.bak
__pycache__/
*.pyc

# Frozen runtime-v2 private evidence is machine-local.
archive/runtime-v2/data/cc-bridge/

# Large media/evidence is retained outside active source.
producer-brain/audio/
producer-brain/assets/
producer-brain/*.jsonl.bak.*

# Machine-local archive bulk: outside active topology, never landed (see ultrareview 2026-07-28 Archive truth)
/archive/local/
!/archive/local/README.md
