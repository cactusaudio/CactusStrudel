#!/usr/bin/env bash
# health — compact readback from the active v3 runtime
set -euo pipefail

if [[ "${1:-}" == "--help" ]]; then
  echo "usage: bin/health"
  echo "Reads GET /api/v2/health. It does not change runtime state."
  exit 0
fi

BASE="${CACTUS_BASE:-http://127.0.0.1:8765}"
payload="$(curl -fsS --max-time 4 "$BASE/api/v2/health" 2>/dev/null || true)"

if [[ -z "$payload" ]]; then
  echo "server ✗  $BASE/api/v2/health unavailable"
  exit 1
fi

printf '%s' "$payload" | python3 -c '
import json, sys
try:
    data = json.load(sys.stdin)
except Exception as exc:
    print(f"server ✗  invalid health response: {exc}")
    raise SystemExit(1)

if not data.get("ok"):
    print("server ✗  runtime reported not ready")
    raise SystemExit(1)

agent = "ready" if data.get("agent_ready") else "inactive"
print(
    "server ✓  api {}  pieces {}  generation-jobs {}  "
    "brain-jobs {}  agent {}  cursor {}".format(
        data.get("api_version", "?"),
        data.get("pieces", "?"),
        data.get("generation_jobs", "?"),
        data.get("brain_jobs", "?"),
        agent,
        data.get("cursor", "?"),
    )
)
'
