{
  "schema_version": 1,
  "description": "CactusStrudel genre code registry — single source of truth mapping Advanced-panel preset keys to short genre codes, categories, and human-readable names. Each new piece generated via Advanced mode is named <CODE>-<NNN> where NNN is the per-code zero-padded 3-digit sequence number.",
  "categories": {
    "club":         {"label": "Club & driving",          "order": 1, "color": "var(--green)"},
    "bass":         {"label": "Bass music",              "order": 2, "color": "var(--gold)"},
    "jazz":         {"label": "Jazz-electronic",         "order": 3, "color": "var(--amber)"},
    "melodic":      {"label": "Melodic dance",           "order": 4, "color": "var(--green)"},
    "downtempo":    {"label": "Downtempo & chill",       "order": 5, "color": "var(--blue)"},
    "experimental": {"label": "Experimental & generative","order": 6, "color": "var(--fg-3)"},
    "uncategorized":{"label": "Uncategorized",           "order": 99, "color": "var(--dim)"}
  },
